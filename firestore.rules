rules_version = '2';

// Reglas de seguridad de QuestLab.
// - Administrador: autoriza docentes (colección teachers, una ficha por correo).
// - Docentes autorizados: crean, editan y publican SUS actividades y ven los resultados de ellas.
// - Cualquier persona con sesión de Google: juega actividades publicadas y guarda SU resultado.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function isAdmin() {
      return signedIn() && myEmail() in ['rodrigorincon9301@gmail.com'];
    }
    function isTeacher() {
      return isAdmin() || (signedIn() && exists(/databases/$(database)/documents/teachers/$(myEmail())));
    }
    function validStatus(data) {
      return data.status in ['draft', 'published'];
    }

    match /teachers/{mail} {
      allow read: if isAdmin() || (signedIn() && mail == myEmail());
      allow write: if isAdmin();
    }

    match /activities/{id} {
      allow read: if signedIn() && (resource.data.status == 'published' || resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isTeacher()
        && request.resource.data.ownerUid == request.auth.uid
        && validStatus(request.resource.data);
      allow update: if isTeacher()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && validStatus(request.resource.data);
      allow delete: if isAdmin() || (isTeacher() && resource.data.ownerUid == request.auth.uid);
    }

    match /results/{id} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.accuracy is number
        && request.resource.data.accuracy >= 0
        && request.resource.data.accuracy <= 100
        && request.resource.data.activityOwnerUid == get(/databases/$(database)/documents/activities/$(request.resource.data.activityId)).data.ownerUid;
      allow read: if signedIn() && (
        resource.data.studentUid == request.auth.uid
        || resource.data.activityOwnerUid == request.auth.uid
        || isAdmin());
      allow delete: if isAdmin() || (signedIn() && resource.data.activityOwnerUid == request.auth.uid);
      allow update: if false;
    }
  }
}
